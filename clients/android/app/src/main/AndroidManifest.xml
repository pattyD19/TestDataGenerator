<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- A 64 GB fill runs for tens of minutes. Android's own limits, never mind
         Samsung's battery manager, will suspend that unless it is a foreground
         service with an ongoing notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- No storage permission. On API 29+ an app needs none to write, read back
         or delete media it owns, which is exactly what this app does. -->

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/stat_sys_download"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.TdgLoader">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".LoaderService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
