<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon: the launcher masks the foreground to whatever shape the OEM
  uses (circle on Pixel, squircle on One UI), so the sheets are drawn inside
  the safe zone rather than filling the canvas. See assets/make_logo.py.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
